{
    "name": "helpdesk",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "next typegen && tsc --noEmit",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "lucide-react": "^1.48.0",
        "next": "16.3.6",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "tailwind-variants": "^3.3.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.3.6",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.9",
        "prettier-plugin-tailwindcss": "0.8.1",
        "tailwindcss": "^4",
        "typescript": "^5"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md}": "prettier --write"
    }
}
